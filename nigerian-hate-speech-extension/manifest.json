{
  "manifest_version": 3,
  "name": "Nigerian Hate Speech Detector",
  "version": "1.0",
  "permissions": [
    "activeTab",
    "storage",
    "scripting"
  ],
  "action": {
    "default_popup": "popup/popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://twitter.com/*",
        "https://x.com/*",
        "https://www.nairaland.com/*"
      ],
      "js": [
        "content/content.js"
      ]
    }
  ],
  "background": {
    "service_worker": "background/background.js"
  }
}
